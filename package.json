{
  "name": "cybersoc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && node --check src/server.mjs && node --check src/index.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "24.19.0", "typescript": "5.9.3" }
}
